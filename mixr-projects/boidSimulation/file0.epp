( GlutDisplay

    name: "Display"
    color: red
    fullScreen: false

    left:       -15.0   // 30 degrees horizontal
    right:       15.0

    bottom:     -15.0   // and 30 degrees vertical
    top:         15.0

    near:        10.0
    far:        -10.0

    clearDepth: 1.0
    clearColor: ( rgb 0 0 0 )

    vpWidth:    1200
    vpHeight:   1000

    stdLineWidth: 2.0

    // This is the default font table, and all fields will use this font if their
    // page's do not have a font table.
    normalFont: default
    fonts: {
      default:
      ( BitmapFont
          fontPosition: [ -9.5 9.5 ]
          fontWidth: 0.462
          fontHeight: 0.798
          bitmapWidth: 11
          bitmapHeight: 19
          characterSpacing: 0.462
          lineSpacing: 0.798
          path: MIXR_DATA_FONT_11_19_PATH
      )
    }

    page: p1
    pages: {
        p1: 
            (Page
                pagingEvent: {
                    n: p2
                    p: p3
                }
               components: {
               ( Boid
                    speed: 10.0                 // 1
                    startAngle: 45              // 2
                    separation: 10.0             // 3
                    alignment: 10.0              // 4
                    cohesion: 10.0               // 5
                    separationMinDist: 0.5      // 6
                    color: (rgb 1 0 0)          // 7
                )
                ( Boid
                    speed: 10.0                 // 1
                    startAngle: 135             // 2
                    separation: 10.0             // 3
                    alignment: 10.0              // 4
                    cohesion: 10.0               // 5
                    separationMinDist: 0.1      // 6
                    color: (rgb 0 1 0)          // 7
                )
            } // components
        ) //p1
    } //pages
) // glutDisplay
