( GlutDisplay

    name: "Display"
    color: red
    fullScreen: false

    left:       -15.0   // 30 degrees horizontal
    right:       15.0

    bottom:     -15.0   // and 30 degrees vertical
    top:         15.0

    near:        10.0
    far:        -10.0

    clearDepth: 1.0
    clearColor: ( rgb 0 0 0 )

    vpWidth:    1200
    vpHeight:   1000

    stdLineWidth: 2.0

    // This is the default font table, and all fields will use this font if their
    // page's do not have a font table.
    normalFont: default
    fonts: {
      default:
      ( BitmapFont
          fontPosition: [ -9.5 9.5 ]
          fontWidth: 0.462
          fontHeight: 0.798
          bitmapWidth: 11
          bitmapHeight: 19
          characterSpacing: 0.462
          lineSpacing: 0.798
          path: MIXR_DATA_FONT_11_19_PATH
      )
    }

    page: p1
    pages: {
        p1: 
            (Page
                pagingEvent: {
                    n: p2
                    p: p3
                }
               components: {
               ( Boid
                    speed: 10.0                 // 1
                    position: [ 5.0 5.0 ]  // 2
                    startAngle: 235              // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.2      // 7
                    color: (rgb 1 0 0)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ -5.0 -5.0 ]  // 2
                    startAngle: 90             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.4      // 7
                    color: (rgb 0 1 0)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ 3.0 -7.0 ]  // 2
                    startAngle: 135             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.2      // 7
                    color: (rgb 0 0 1)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ -10.0 1.0 ]  // 2
                    startAngle: 35             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.4      // 7
                    color: (rgb 1 1 0)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ 7.0 -4.0 ]  // 2
                    startAngle: 150             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.3      // 7
                    color: (rgb 1 1 1)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ 12.0 3.0 ]  // 2
                    startAngle: 160             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.4      // 7
                    color: (rgb 0.5 1 0.5)          // 8
                    detectionRadius: 5.0        // 9
                )
                ( Boid
                    speed: 10.0                 // 1
                    position: [ 2.0 13.0 ]  // 2
                    startAngle: 290             // 3
                    separation: 5.0            // 4
                    alignment: 5.0             // 5
                    cohesion: 5.0              // 6
                    separationMinDist: 0.2      // 7
                    color: (rgb 0.2 0.2 0.3)          // 8
                    detectionRadius: 5.0        // 9
                )
            } // components
        ) //p1
    } //pages
) // glutDisplay
